{
  "name": "mini-codex",
  "version": "0.1.0",
  "description": "Embeddable Codex-powered agent workbench for host applications.",
  "type": "module",
  "keywords": [
    "codex",
    "agent",
    "workbench",
    "react",
    "tldraw",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahooki/mini-codex.git"
  },
  "bugs": {
    "url": "https://github.com/tahooki/mini-codex/issues"
  },
  "homepage": "https://github.com/tahooki/mini-codex#readme",
  "sideEffects": [
    "./dist/react/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./codex-sdk": {
      "types": "./dist/codex-sdk/index.d.ts",
      "import": "./dist/codex-sdk/index.js"
    },
    "./tldraw": {
      "types": "./dist/tldraw/index.d.ts",
      "import": "./dist/tldraw/index.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration/index.d.ts",
      "import": "./dist/orchestration/index.js"
    },
    "./styles.css": "./dist/react/styles.css"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "demo:basic:build": "npm run build && npm run build --prefix examples/basic-react",
    "demo:basic:dev": "npm run dev --prefix examples/basic-react",
    "demo:electron:build": "npm run build && npm run build --prefix examples/electron-todo-dashboard",
    "demo:electron:dev": "npm run dev --prefix examples/electron-todo-dashboard",
    "demo:tldraw:build": "npm run build && npm run build --prefix examples/tldraw-react",
    "demo:tldraw:dev": "npm run dev --prefix examples/tldraw-react",
    "pack:dry-run": "npm pack --dry-run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm audit --omit=optional && npm run pack:dry-run"
  },
  "peerDependencies": {
    "@openai/codex-sdk": ">=0.137.0",
    "react": ">=18.2.0",
    "tldraw": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex-sdk": {
      "optional": true
    },
    "tldraw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openai/codex-sdk": "^0.137.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tldraw": "^5.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
